// The Cloudflare Worker behind karansadiora.com. Workers Builds runs `npm run build` and then
// `npx wrangler deploy` on every push to main. Custom domains (karansadiora.com, www) are managed in the
// dashboard and deliberately not listed here, so a deploy never changes them.
{
  "name": "karansadiora",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Everything is served straight from dist/ except EyeSpeak's repair endpoint, which runs the Worker.
    "run_worker_first": ["/eyespeak/api/*"]
  },
  // At most 20 sentence repairs a minute per visitor, so nobody can run up the Gemini key.
  "ratelimits": [{ "name": "EYESPEAK_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  "observability": { "enabled": true }
}
